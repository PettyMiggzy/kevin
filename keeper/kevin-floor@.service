# The floor keeper, as a service — one TEMPLATE, one instance per pool.
#
# There are two floor keepers, one on each pool, and they are the same program
# pointed at different contracts. So this is a systemd template unit: the bit
# after the @ becomes %i, and %i picks the environment file.
#
#   cp 'keeper/kevin-floor@.service' /etc/systemd/system/
#   mkdir -p /etc/kevin
#   cp keeper/floor-weth.env.example /etc/kevin/floor-weth.env
#   cp keeper/floor-kek.env.example  /etc/kevin/floor-kek.env
#   systemctl daemon-reload
#   systemctl enable --now kevin-floor@weth kevin-floor@kek
#
# Watch them:  journalctl -fu kevin-floor@weth -u kevin-floor@kek
# Stop one:    systemctl stop kevin-floor@kek
#
# The operator key is NOT in here and NOT in the env files. It lives in
# /opt/kevin/keeper/.operator.key, chmod 600, gitignored — this repo is public.
#
# BOTH INSTANCES START IN DRY RUN. They print what they would do and send
# nothing. To make one send, set LIVE=1 in ITS env file and restart it — one
# pool at a time, so a mistake is half a mistake.

[Unit]
Description=Kevin floor keeper (%i pool)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/opt/kevin
ExecStart=/usr/bin/env node keeper/floor.mjs
# Per-pool settings, including FLOOR_ADDRESS. Kept outside the repo so a git
# pull cannot wipe them and a public repo cannot leak them.
EnvironmentFile=/etc/kevin/floor-%i.env
Environment=CHAIN_ID=4663
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kevin-floor-%i

[Install]
WantedBy=multi-user.target
