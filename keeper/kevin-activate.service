# The warm-up bell, as a service.
#
# KevinStaking's accumulator is global, so nothing fires by itself when one
# account's warm-up ends — somebody has to call activate(). If nothing does,
# people who staked and waited earn NOTHING and cannot tell why. That is what
# this exists to prevent.
#
# The operator key is NOT in here. It lives in /opt/kevin/keeper/.operator.key,
# chmod 600, gitignored — this repo is public.
#
# STARTS IN DRY RUN. To make it send, add LIVE=1 to the drop-in:
#   systemctl edit kevin-activate
#   [Service]
#   Environment=LIVE=1
[Unit]
Description=Kevin staking warm-up bell
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/opt/kevin
ExecStart=/usr/bin/env node keeper/activate.mjs
Environment=CHAIN_ID=4663
# Set these in a drop-in rather than here, so a git pull cannot wipe them:
#   Environment=STAKING_ADDRESS=0x...
#   Environment=ROBINHOOD_RPC_URL=https://...
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kevin-activate

[Install]
WantedBy=multi-user.target
