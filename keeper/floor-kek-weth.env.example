# /etc/kevin/floor-kek-weth.env — the KEK/WETH floor keeper.
# Copy, do not symlink: this file lives outside the repo on purpose.

# Fill this in with the address from the deploy receipt — see
# contracts/deploy/README.md, "KevinFloorV4 (KEK/WETH)".
FLOOR_ADDRESS=0x0000000000000000000000000000000000000000
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# How often it looks. Every look is a read, and reads are free — the only cost
# is requests against your RPC key, and one tick is now 3 JSON-RPC calls, not
# 17, because the client folds them through Multicall3. At 45s that is about
# 5,800 calls a day. Nothing.
TICK_MS=45000

# LEAVE THIS OFF unless you have measured the bandwidth. See keeper/README.md.
# FEED_URL=wss://feed.mainnet.chain.robinhood.com
# IDLE_MS=300000

# Rails on THIS pool, read off the chain at deploy time (2026-09-11): the pool
# only held about $8,400 total ($4,195 in KEK, $4,192 in WETH — 295,197,678
# KEK and 1.6487 WETH). This pool is tiny next to the KEVIN ones, so the rails
# set on the contract at deploy time are sized way down to match:
# 15,000,000 KEK a trade / 60,000,000 KEK a day out (sell side), and
# 0.08 WETH a trade / 0.35 WETH a day in (buy side). See
# contracts/deploy/README.md for the exact setRails/setPolicy calls.
#
# DRY RUN until this says 1. Uncomment only when the contract holds KEK to
# sell and WETH in the war chest to buy with — before that every poke reverts.
# LIVE=1
