# /etc/kevin/floor-weth.env — the KEVIN/WETH floor keeper.
# Copy, do not symlink: this file lives outside the repo on purpose.

FLOOR_ADDRESS=0xd7309Cc9383Feb44d09202764A72951B962a25Ab
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# How often it looks. Every look is a read, and reads are free — the only cost
# is requests against your RPC key, and one tick is now 3 JSON-RPC calls, not
# 17, because the client folds them through Multicall3. At 45s that is about
# 5,800 calls a day. Nothing.
TICK_MS=45000

# LEAVE THIS OFF unless you have measured the bandwidth. See keeper/README.md:
# the sequencer feed is the whole chain unfiltered, about 32 GB a day, and with
# two keepers subscribed that is nearly two thirds of a droplet's monthly
# transfer. It buys latency, not correctness — the timer already covers it.
# FEED_URL=wss://feed.mainnet.chain.robinhood.com
# IDLE_MS=300000

# DRY RUN until this says 1. Uncomment only when the contract holds $KEVIN to
# sell and WETH in the war chest to buy with — before that every poke reverts.
# LIVE=1
