# /etc/kevin/cashcat.env — the Cash Cat accumulator.
# Copy, do not symlink: this file lives outside the repo on purpose.

ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# These four are already the right defaults (see keeper/cashcat-accumulate.mjs)
# — only set them if you are pointing this at a different pool entirely.
# POOL_ADDRESS=0xA70fc67C9F69da90B63a0e4C05D229954574E313
# TOKEN_ADDRESS=0x020bfC650A365f8BB26819deAAbF3E21291018b4
# WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
# ROUTER_ADDRESS=0xCAf681a66D020601342297493863E78C959e5CB2

# How often it looks.
TICK_MS=45000

# Buy when spot has fallen this many bps below the recent high (500 = 5%),
# measured over REF_WINDOW_MS (default 6h).
DIP_BPS=500
REF_WINDOW_MS=21600000

# THE ACTUAL SAFETY RAILS. Unlike keeper/floor.mjs, there is no contract of
# ours in the loop to enforce these on chain — this script and a small,
# dedicated wallet are the only things standing between a bug (or a leaked
# key) and the wallet's whole balance. Keep these small, and keep the wallet
# funded with only what you are willing to lose.
MAX_WETH_PER_TRADE_WEI=1000000000000000   # 0.001 WETH
DAILY_WETH_CAP_WEI=5000000000000000       # 0.005 WETH
COOLDOWN_S=3600

SLIP_BUFFER_BPS=200
MIN_GAS_WEI=500000000000000               # 0.0005 ETH

# DRY RUN until this says 1. Uncomment only once keeper/.cashcat.key exists
# and the wallet actually holds WETH to spend.
# LIVE=1
