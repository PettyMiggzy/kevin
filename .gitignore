node_modules/
.DS_Store
*.log

# scratch render/QA scripts, kept out of the repo
tools/_*.mjs

# Venice API key — never commit this
tools/.venice.key
.venice.key
tools/.tripo.key
.tripo.key

# Tripo output before optimisation — big, and re-derivable from state.json
gym/assets/props/raw/
package-lock.json

# Foundry deps — restored with `forge install`, not committed
contracts/lib/
contracts/out/
contracts/cache/

dist/

# Bot keys — never commit these
bot/.groq.key
bot/.telegram.key

# Scores service admin key — never commit
server/.admin.key
server/data/

# Scratch frames from tools/render-sticker.mjs
.sticker-frames/

# The 1,000 PFP renders. Regenerate with:
#   node tools/gen-pfp.mjs --count 1000 --seed 20260907
assets/pfp/*.png

# Rig scratch frames from tools/rig.mjs
.sticker-frames/rig/

# forge run from the repo root instead of contracts/ leaves these here
cache/
out/

# Keeper operator key — never commit this
keeper/.operator.key
keeper/.operator-weth.key

# Buy watch cursor and seen-transaction set — local state, not source
keeper/.buywatch.state

# Which burns have actually been announced. Local state, and NOT the same file
# as data/burns.json: the receipts are published, the ledger is per-deployment.
data/.burnwatch.announced
*.tmp

# Audit scratch reproductions. Verifier agents write a throwaway test to prove
# or disprove a finding and are told to delete it; some do not. They are
# evidence for one claim, not part of the suite — a confirmed finding gets
# promoted to a properly named regression test instead.
contracts/test/Zz*.t.sol
contracts/test/ZZ*.t.sol

# Throwaway probe scripts. Reading the chain needs the repo's node_modules, so
# these have to live at the root rather than in a scratch directory — but none
# of them is worth committing, and forgetting to delete one leaves the tree
# dirty. Anything matching this is temporary by construction.
/.probe-*.mjs
/.arb*.mjs
/.px.mjs
/.pools.mjs
/.render.mjs
/.shot.mjs
/.rpccount.mjs
/.verify.mjs
/.errshape.mjs
/.noncetest.mjs
/.liveread.mjs
/.treasury.mjs
/.feedprobe.mjs
