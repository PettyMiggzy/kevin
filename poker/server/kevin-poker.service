# The multiplayer poker server.
#   cp poker/server/kevin-poker.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now kevin-poker
#
# Everything this process holds — tables, seats, chips, the deck — is
# in-memory only (see poker/server/README.md). Restarting it clears every
# table, which is expected and fine for play money.
[Unit]
Description=Kevin poker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/opt/kevin
ExecStart=/usr/bin/env node poker/server/index.mjs
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kevin-poker

# Bound to localhost by the reverse proxy in front of it; see
# poker/server/README.md's "Putting it on the internet" section.
Environment=PORT=8788
# Only the site should be able to open a socket to this from a browser.
# Both the apex and `www.` — Vercel serves the real site from
# `www.iamkevin.lol` (redirecting the apex there), so a visitor's actual
# Origin header is whichever one the page loaded from, not just one of them.
Environment=KEVIN_ORIGIN=https://iamkevin.lol,https://www.iamkevin.lol

# No filesystem access needed at all — everything lives in memory.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
